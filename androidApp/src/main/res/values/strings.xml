<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Lista de Compras</string>
    <!-- Botão no topo das telas que abrem por cima da lista (adicionar, editar) -->
    <string name="back_to_list">Voltar para a lista</string>
    <!-- Botão do aviso no meio da tela que desfaz a última ação (guia de linguagem, 2026-11-23) -->
    <string name="undo">Desfazer</string>
    <!-- Botão do aviso no meio da tela que só fecha o aviso (guia de linguagem, 2026-11-23; nunca "OK") -->
    <string name="notice_dismiss">Certo</string>

    <!-- Tela da lista (#50) -->
    <!-- Em HTML escapado, para o negrito chegar ao Compose (AnnotatedString.fromHtml) -->
    <!-- Título da lista vazia (#121); caixa alta vem do estilo -->
    <string name="list_title">Lista de Compras</string>
    <!-- Nome da família de apps, pequeno acima do título da lista vazia (logo, plano §4.8); caixa alta vem do estilo -->
    <string name="app_family_name">Mente Alerta</string>
    <string name="list_empty">Toque em &lt;b>Adicionar&lt;/b> para começar sua lista.</string>
    <!-- Seção no fim da lista com os produtos riscados (#121) -->
    <string name="list_bought_section">Já peguei</string>
    <!-- Estado lido pelo TalkBack num produto riscado -->
    <string name="list_item_checked">Comprado</string>
    <!-- Ação do TalkBack para riscar o produto (#51) -->
    <string name="list_item_mark_bought">Marcar como comprado</string>
    <!-- Ação do TalkBack para desriscar o produto (#51) -->
    <string name="list_item_unmark">Tirar o risco</string>
    <!-- Rodapé da lista (#52): "Adicionar" sempre; "Terminei" depois do primeiro risco -->
    <string name="list_add">Adicionar</string>
    <string name="list_finish">Terminei</string>
    <!-- Abaixo do "Terminei": quantos produtos ainda não foram riscados -->
    <plurals name="list_remaining">
        <item quantity="one">Falta %d</item>
        <item quantity="many">Faltam %d</item>
        <item quantity="other">Faltam %d</item>
    </plurals>
    <!-- Abaixo do "Terminei", com todos os produtos riscados -->
    <string name="list_nothing_remaining">Não falta nada</string>
    <!-- Aviso depois do "Terminei" (#57), com o botão "Desfazer": "Pronto! 8 produtos comprados." -->
    <plurals name="list_finished_bought">
        <item quantity="one">Pronto! %d produto comprado.</item>
        <item quantity="many">Pronto! %d produtos comprados.</item>
        <item quantity="other">Pronto! %d produtos comprados.</item>
    </plurals>
    <!-- Segunda frase do aviso do "Terminei", quando ficaram produtos não riscados -->
    <plurals name="list_finished_remaining">
        <item quantity="one">Ficou %d na lista para a próxima vez.</item>
        <item quantity="many">Ficaram %d na lista para a próxima vez.</item>
        <item quantity="other">Ficaram %d na lista para a próxima vez.</item>
    </plurals>
    <!-- Junta as duas frases do aviso do "Terminei": "Pronto! 8 produtos comprados." + "Ficaram 3…" -->
    <string name="list_finished">%1$s %2$s</string>
    <!-- Botão no fim da folha (#121): abre a lista para mudar os produtos -->
    <string name="list_change">Mudar a lista</string>
    <!-- No topo do modo "Mudar a lista" -->
    <string name="list_change_hint">Toque no produto que quer mudar.</string>
    <!-- Ação do TalkBack num produto: abre a edição (modo "Mudar a lista" e linha da lista, #71) -->
    <string name="list_item_change">Mudar</string>
    <!-- Ação do TalkBack na linha da lista: tira o produto, com o aviso e "Desfazer" (#71) -->
    <string name="list_item_remove">Tirar da lista</string>
    <!-- No fim do modo "Mudar a lista" (#58, #121): a única ação que pede confirmação (guia de linguagem) -->
    <string name="list_clear">Jogar a lista fora</string>
    <!-- Título da confirmação de jogar a lista fora -->
    <string name="list_clear_question">Jogar a lista fora?</string>
    <!-- Abaixo do título da confirmação: quantos produtos saem, riscados ou não -->
    <plurals name="list_clear_count">
        <item quantity="one">O produto será tirado.</item>
        <item quantity="many">Os %d produtos serão tirados.</item>
        <item quantity="other">Os %d produtos serão tirados.</item>
    </plurals>
    <string name="list_clear_yes">Sim, jogar fora</string>
    <string name="list_clear_no">Não</string>
    <!-- Aviso depois de jogar a lista fora, com o botão "Desfazer" -->
    <string name="list_cleared">A lista foi jogada fora.</string>
    <!-- Aviso depois de tirar o produto da lista, com o botão "Desfazer" -->
    <string name="list_item_removed">%1$s saiu da lista.</string>
    <!-- Produto com detalhe: "Leite" + "desnatado" -->
    <string name="list_item_name_with_detail">%1$s %2$s</string>
    <!-- Produto com quantidade, como o TalkBack lê: "Leite desnatado, 2 litros" -->
    <string name="list_item_with_quantity">%1$s, %2$s</string>

    <!-- Tela de adicionar (#53) -->
    <!-- Rótulo do campo (#122), em caixa normal por ser uma frase -->
    <string name="add_search_label">Digite ou fale o que quer comprar.</string>
    <!-- Título acima dos produtos achados pela busca (#122) -->
    <string name="add_found">Adicionar na lista de compras</string>
    <!-- Título da lista do que entrou desde que a tela abriu (#122) -->
    <string name="add_added_title">Adicionados</string>
    <!-- TalkBack na lixeira de cada produto de "Adicionados" (2026-11-23): "Tirar leite da lista" -->
    <string name="add_added_remove">Tirar %1$s da lista</string>
    <!-- Sem nenhum produto achado, acima da opção de pôr o texto como está -->
    <string name="add_nothing_found">Não achei esse produto. Pode pôr assim mesmo:</string>
    <!-- Opção do produto que o app não conhece, com o texto digitado -->
    <string name="add_unknown">Pôr “%1$s” na lista</string>
    <!-- Aviso depois de pôr o produto na lista, lido também pelo TalkBack; serve para masculino e feminino (#122) -->
    <string name="add_added">Adicionado: %1$s.</string>
    <!-- Produto repetido (#54): pergunta quando o produto já está na lista, lida também pelo TalkBack -->
    <string name="add_already_there">%1$s já está na lista. Quer mais um?</string>
    <string name="add_more_one">Sim, mais um</string>
    <string name="add_keep_as_is">Não</string>
    <!-- Aviso depois do "Sim, mais um" -->
    <string name="add_added_again">Adicionado de novo: %1$s.</string>

    <!-- Falar os produtos (#60, plano §3.3) -->
    <string name="add_speak">Falar</string>
    <!-- Acima do botão Falar (#123): o microfone fica aberto enquanto o dedo segura -->
    <string name="add_speak_hint">Segure para falar.</string>
    <!-- Explicação antes do pedido de microfone, uma vez (guia de linguagem) -->
    <string name="add_voice_notice">Para você falar os produtos, o app precisa usar o microfone. Para entender o que você fala, o celular pode enviar o som ao Google.</string>
    <string name="add_voice_notice_yes">Usar o microfone</string>
    <string name="add_voice_notice_no">Escrever</string>
    <!-- Enquanto o microfone está aberto, lido também pelo TalkBack -->
    <string name="add_voice_listening">Estou ouvindo. Pode falar.</string>
    <!-- Fecha o microfone; o que já foi falado entra na lista -->
    <string name="add_voice_done">Terminei</string>
    <string name="add_voice_not_understood">Não entendi. Pode falar de novo?</string>
    <string name="add_voice_no_internet">Sem internet, não consigo ouvir agora. Você pode escrever.</string>
    <!-- A pessoa não deixou usar o microfone -->
    <string name="add_voice_no_microphone">Sem o microfone, não consigo ouvir. Você pode escrever.</string>
    <!-- Toque rápido no Falar, sem segurar (#123) -->
    <string name="add_voice_hold">Segure o botão enquanto fala.</string>
    <!-- A voz pt-BR ainda não está no celular; o download foi pedido (#123) -->
    <string name="add_voice_downloading">Estou baixando a voz para ouvir sem internet. Você pode escrever enquanto isso.</string>
    <!-- O microfone ou o serviço de voz não funcionaram (ocupado, outro erro) -->
    <string name="add_voice_unavailable">Não deu certo ouvir agora. Você pode escrever.</string>
    <!-- Falado que já estava na lista e não entrou de novo (#127); com vários, o add_already_on_list_many -->
    <string name="add_already_on_list">%1$s já estava na lista.</string>
    <plurals name="add_already_on_list_many">
        <item quantity="one">%d produto já estava na lista.</item>
        <item quantity="many">%d produtos já estavam na lista.</item>
        <item quantity="other">%d produtos já estavam na lista.</item>
    </plurals>
    <!-- Aviso depois de falar vários produtos de uma vez (com um só, vale o add_added) -->
    <plurals name="add_added_many">
        <item quantity="one">Adicionado: %d produto.</item>
        <item quantity="many">Adicionados: %d produtos.</item>
        <item quantity="other">Adicionados: %d produtos.</item>
    </plurals>

    <!-- Edição do produto (#55): tudo é salvo sozinho, não existe "Salvar" -->
    <string name="edit_name_label">Nome</string>
    <string name="edit_quantity_label">Quantidade</string>
    <string name="edit_less">Menos</string>
    <string name="edit_more">Mais</string>
    <string name="edit_detail_label">Detalhe</string>
    <!-- Aparece no campo vazio; o TalkBack lê só o rótulo -->
    <string name="edit_detail_hint">Ex.: desnatado, da marca X</string>
    <!-- TalkBack num campo vazio: o rótulo e o exemplo que aparece dentro dele, ex.: "Detalhe, Ex.: desnatado" (#71) -->
    <string name="field_label_with_hint">%1$s, %2$s</string>
    <string name="edit_remove">Tirar da lista</string>

    <!--
        Quantidade do produto. %1$s é o número já formatado ("2", "1,5", "½").
        Na tela, ½ aparece como símbolo; o TalkBack lê a versão com "meio" / "meia".
    -->
    <string name="quantity_half">½</string>
    <plurals name="quantity_unit">
        <item quantity="one">%1$s</item>
        <item quantity="many">%1$s</item>
        <item quantity="other">%1$s</item>
    </plurals>
    <plurals name="quantity_kilogram">
        <item quantity="one">%1$s kg</item>
        <item quantity="many">%1$s kg</item>
        <item quantity="other">%1$s kg</item>
    </plurals>
    <plurals name="quantity_gram">
        <item quantity="one">%1$s g</item>
        <item quantity="many">%1$s g</item>
        <item quantity="other">%1$s g</item>
    </plurals>
    <plurals name="quantity_liter">
        <item quantity="one">%1$s litro</item>
        <item quantity="many">%1$s litros</item>
        <item quantity="other">%1$s litros</item>
    </plurals>
    <plurals name="quantity_dozen">
        <item quantity="one">%1$s dúzia</item>
        <item quantity="many">%1$s dúzias</item>
        <item quantity="other">%1$s dúzias</item>
    </plurals>
    <!-- Uma meia dúzia aparece sem o número -->
    <string name="quantity_one_half_dozen">meia dúzia</string>
    <plurals name="quantity_half_dozen">
        <item quantity="one">%1$s meia dúzia</item>
        <item quantity="many">%1$s meias dúzias</item>
        <item quantity="other">%1$s meias dúzias</item>
    </plurals>
    <plurals name="quantity_package">
        <item quantity="one">%1$s pacote</item>
        <item quantity="many">%1$s pacotes</item>
        <item quantity="other">%1$s pacotes</item>
    </plurals>
    <plurals name="quantity_box">
        <item quantity="one">%1$s caixa</item>
        <item quantity="many">%1$s caixas</item>
        <item quantity="other">%1$s caixas</item>
    </plurals>
    <plurals name="quantity_can">
        <item quantity="one">%1$s lata</item>
        <item quantity="many">%1$s latas</item>
        <item quantity="other">%1$s latas</item>
    </plurals>
    <plurals name="quantity_bottle">
        <item quantity="one">%1$s garrafa</item>
        <item quantity="many">%1$s garrafas</item>
        <item quantity="other">%1$s garrafas</item>
    </plurals>
    <plurals name="quantity_bunch">
        <item quantity="one">%1$s maço</item>
        <item quantity="many">%1$s maços</item>
        <item quantity="other">%1$s maços</item>
    </plurals>
    <plurals name="quantity_tray">
        <item quantity="one">%1$s bandeja</item>
        <item quantity="many">%1$s bandejas</item>
        <item quantity="other">%1$s bandejas</item>
    </plurals>
    <plurals name="quantity_jar">
        <item quantity="one">%1$s pote</item>
        <item quantity="many">%1$s potes</item>
        <item quantity="other">%1$s potes</item>
    </plurals>

    <!-- Meia unidade lida pelo TalkBack (na tela fica "½ kg") -->
    <string name="quantity_half_unit">meia unidade</string>
    <string name="quantity_half_kilogram">meio quilo</string>
    <string name="quantity_half_gram">meio grama</string>
    <string name="quantity_half_liter">meio litro</string>
    <string name="quantity_half_of_dozen">meia dúzia</string>
    <string name="quantity_half_package">meio pacote</string>
    <string name="quantity_half_box">meia caixa</string>
    <string name="quantity_half_can">meia lata</string>
    <string name="quantity_half_bottle">meia garrafa</string>
    <string name="quantity_half_bunch">meio maço</string>
    <string name="quantity_half_tray">meia bandeja</string>
    <string name="quantity_half_jar">meio pote</string>
</resources>
