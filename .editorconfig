root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 120
ktlint_code_style = intellij_idea
# Funções @Composable começam com maiúscula (convenção do Compose)
ktlint_function_naming_ignore_when_annotated_with = Composable
# Regras de Compose: CompositionLocals permitidos (tokens do tema)
compose_allowed_composition_locals = LocalComicTokens
# Sem linha em branco obrigatória entre ramos do when
ktlint_standard_blank-line-between-when-conditions = disabled
